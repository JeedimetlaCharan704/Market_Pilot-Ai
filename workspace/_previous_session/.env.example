# --- Core ---
# Supabase Postgres connection string (Supabase Dashboard -> Connect -> Session pooler)
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.REF.supabase.co:6543/postgres

# --- LiteLLM model providers (ALL model calls go through LiteLLM) ---
# Gemini = primary, Groq = fallback (see config.yaml -> llm)
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Business discovery ---
# Google Places API key. If empty, discovery falls back to OpenStreetMap (no key).
GOOGLE_MAPS_API_KEY=

# --- Outreach (Resend API for sending) ---
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=

# --- Reply inbox (IMAP, read-only) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional overrides ---
# MARKETPILOT_CONFIG=/path/to/config.yaml
# MARKETPILOT_LOG_LEVEL=INFO

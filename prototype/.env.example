# ---------------------------------------------------------------------------
# Discovery backend: osm (default, keyless) | google_places | scraper_docker
# ---------------------------------------------------------------------------
DISCOVERY_BACKEND=osm
# Only needed for google_places
GOOGLE_MAPS_API_KEY=
# Only needed for scraper_docker (the official Google Maps Scraper Kit engine)
SCRAPER_BASE_URL=http://localhost:8080
SCRAPER_API_KEY=

# Hard cap on businesses returned per search
DISCOVERY_LIMIT=8

# ---------------------------------------------------------------------------
# LLM. Leave LLM_PROVIDER empty to auto-detect whichever key below is present.
# gemini | groq | ollama | openai | openai_compatible | none
# openai_compatible covers OpenRouter, together, and any OpenAI-shaped endpoint.
# ---------------------------------------------------------------------------
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Leave empty to use DEFAULT_MODELS in modules/llm.py, re-verified live on
# 2026-10-09: gemini-3.8-flash and openai/gpt-oss-120b. The older default IDs
# now return HTTP 404 from both providers.
LLM_MODEL=
# Local model, no key. Set LLM_PROVIDER=ollama after `ollama pull llama3.1`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Where this app is reachable from outside - used to build demo links in emails
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Outbound email. Empty = the Send button writes outbox.log only and the UI
# says so. Set these to make Send deliver for real to SMTP_TEST_TO (your own
# inbox - a controlled test recipient, never a mailing list).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TEST_TO=

# ---------------------------------------------------------------------------
# Inbound replies. Same Gmail app password as above; IMAP must be enabled in
# Gmail settings (Settings -> See all settings -> Forwarding and POP/IMAP).
# Leave both empty and "Check replies" returns a clear 503 instead of failing.
# ---------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------------------------------------------------------------------------
# Telegram alerts. Optional. Get a token from @BotFather, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot once
# to read your chat_id out of the JSON.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Politeness / safety
# ---------------------------------------------------------------------------
USER_AGENT=MarketPilot-Prototype/1.0 (hackathon; contact: you@example.com)
REQUEST_TIMEOUT=10
# seconds between outbound HTTP requests to the same host
RATE_LIMIT_SECONDS=1.0
# Set to 1 only if every live backend fails and you accept fixture data
ALLOW_FALLBACK=0
DAILY_SEND_CAP=20
